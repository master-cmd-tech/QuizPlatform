@implements IDisposable

@if (Seconds > 0)
{
    <div class="timer @(_remaining <= 5 ? "urgent" : "")" role="timer" aria-label="Time left">
        ⏱ @_remaining s
    </div>
    <div class="progress thin" aria-hidden="true">
        <div class="progress-fill warn" style="width:@Percent%"></div>
    </div>
}

@code {
    [Parameter] public int Seconds { get; set; }
    /// <summary>Changing this value restarts the timer (e.g. the id of the current question).</summary>
    [Parameter] public object? ResetKey { get; set; }
    [Parameter] public EventCallback OnElapsed { get; set; }

    private int _remaining;
    private object? _lastKey;
    private bool _started;
    private CancellationTokenSource? _cts;

    private int Percent => Seconds <= 0 ? 0 : (int)Math.Round(100.0 * _remaining / Seconds);

    protected override void OnParametersSet()
    {
        if (!_started || !Equals(_lastKey, ResetKey))
        {
            _started = true;
            _lastKey = ResetKey;
            Restart();
        }
    }

    private void Restart()
    {
        _cts?.Cancel();
        _cts?.Dispose();
        _cts = new CancellationTokenSource();
        _remaining = Seconds;
        if (Seconds > 0) _ = RunAsync(_cts.Token);
    }

    private async Task RunAsync(CancellationToken ct)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        try
        {
            while (await timer.WaitForNextTickAsync(ct))
            {
                _remaining--;
                await InvokeAsync(StateHasChanged);
                if (_remaining <= 0)
                {
                    await InvokeAsync(() => OnElapsed.InvokeAsync());
                    return;
                }
            }
        }
        catch (OperationCanceledException) { /* restarted or disposed */ }
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
    }
}
