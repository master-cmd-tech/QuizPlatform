@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@inherits LayoutComponentBase
@implements IDisposable
@inject AppState State
@inject ProtectedSessionStorage Session
@inject ILogger<MainLayout> Logger

<a class="skip-link" href="#main">Skip to content</a>

<div class="shell">
    <header class="topbar">
        <button class="menu-btn" type="button" aria-label="Toggle navigation"
                aria-expanded="@(_navOpen ? "true" : "false")" @onclick="() => _navOpen = !_navOpen">☰</button>
        <a class="brand" href="">🎓 QuizLab</a>
        <div class="spacer"></div>
        @if (State.IsSignedIn)
        {
            <span class="user-chip" title="Signed in">
                👤 @State.Player <span class="badge">@State.Role</span>
            </span>
            <button class="btn small" type="button" @onclick="State.SignOut">Sign out</button>
        }
        else
        {
            <a class="btn small primary" href="">Sign in</a>
        }
    </header>

    <nav class="nav @(_navOpen ? "open" : "")" aria-label="Main" @onclick="() => _navOpen = false">
        <NavMenu />
    </nav>

    <main id="main" class="content">
        <ErrorBoundary @ref="_boundary">
            <ChildContent><ToastHost>@Body</ToastHost></ChildContent>
            <ErrorContent>
                <div class="card error" role="alert">
                    <h2>Something went wrong</h2>
                    <p>This part of the page failed, but the rest of the app is fine.</p>
                    <button class="btn primary" type="button" @onclick="() => _boundary?.Recover()">Try again</button>
                </div>
            </ErrorContent>
        </ErrorBoundary>
    </main>
</div>

@code {
    private bool _navOpen;
    private ErrorBoundary? _boundary;

    public sealed record SavedUser(string Name, Role Role);

    protected override void OnInitialized() => State.Changed += OnStateChanged;

    protected override void OnParametersSet() => _boundary?.Recover();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            var saved = await Session.GetAsync<SavedUser>("user");
            if (saved.Success && saved.Value is { } u && !State.IsSignedIn)
                State.SignIn(new SignedInUser(u.Name, u.Role));
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Could not restore the saved session.");
        }
    }

    private void OnStateChanged() => _ = InvokeAsync(async () =>
    {
        try
        {
            if (State.IsSignedIn) await Session.SetAsync("user", new SavedUser(State.Player, State.Role));
            else await Session.DeleteAsync("user");
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Could not persist the session.");
        }
        StateHasChanged();
    });

    public void Dispose() => State.Changed -= OnStateChanged;
}
